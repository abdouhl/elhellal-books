---
import Layout from "../layouts/Layout.astro";
import books from "../data/books.json";

const sorted = [...books].sort((a, b) => a.title.localeCompare(b.title, "ar"));
---

<Layout
    pageTitle="ملخصات كتب عربية | الهلال"
    pageDescription="ملخصات موجزة لأهم الروايات والكتب العربية: الأفكار الرئيسية، لمن هذا الكتاب، واقتباساته الأشهر."
    canonicalUrl="https://books.elhellal.com/"
>
    <main class="page">
        <h1>ملخصات كتب</h1>
        <p class="sub">{sorted.length} كتاباً وملخصاً حتى الآن — نضيف المزيد كل أسبوع.</p>

        <ul role="list" class="grid">
            {sorted.map((b) => (
                <li>
                    <a href={`/${b.slug}/`} class="card">
                        <img src={b.cover} alt={b.title} loading="lazy" />
                        <div class="card-body">
                            <h2>{b.title}</h2>
                            <p class="author">{b.author}</p>
                            <p class="genre">{b.genre}{b.award ? ` · ${b.award}` : ""}</p>
                        </div>
                    </a>
                </li>
            ))}
        </ul>
    </main>

    <style>
        .page {
            max-width: 1100px;
            margin: 0 auto;
            padding: var(--spacing-07, 2rem) var(--spacing-05, 1.25rem) var(--spacing-10, 3rem);
        }
        h1 {
            margin: 0 0 var(--spacing-02, 0.5rem);
            font-size: clamp(1.75rem, 3.5vw, 2.5rem);
        }
        .sub {
            color: var(--content-secondary, #666);
            margin: 0 0 var(--spacing-07, 2rem);
        }
        .grid {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: var(--spacing-05, 1.25rem);
        }
        .card {
            display: block;
            text-decoration: none;
            color: inherit;
            border: 1px solid var(--border-primary, #e5e5e5);
            border-radius: 8px;
            overflow: hidden;
            transition: box-shadow 0.15s ease, transform 0.15s ease;
        }
        .card:hover {
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
            transform: translateY(-2px);
        }
        .card img {
            width: 100%;
            aspect-ratio: 2 / 3;
            object-fit: cover;
            display: block;
            background: var(--background-secondary, #f2f2f2);
        }
        .card-body {
            padding: var(--spacing-04, 1rem);
        }
        .card-body h2 {
            margin: 0 0 4px;
            font-size: 1.05rem;
        }
        .author {
            margin: 0;
            font-size: 0.9rem;
            color: var(--content-secondary, #666);
        }
        .genre {
            margin: 6px 0 0;
            font-size: 0.75rem;
            color: var(--accent, #0a5);
        }
    </style>
</Layout>
