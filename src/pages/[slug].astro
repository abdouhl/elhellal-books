---
import Layout from "../layouts/Layout.astro";
import books from "../data/books.json";
import AdUnit from "../components/AdUnit.astro";

export function getStaticPaths() {
    // Long-form summaries live in src/content/summaries/<slug>.md; books without one fall back to the short entry.
    const longForm = import.meta.glob("../content/summaries/*.md", { eager: true }) as Record<string, any>;
    return books.map((b) => {
        const md = longForm[`../content/summaries/${b.slug}.md`];
        const words = md ? md.rawContent().split(/\s+/).filter(Boolean).length : 0;
        return {
            params: { slug: b.slug },
            props: { book: b, Content: md?.Content ?? null, minutes: Math.max(1, Math.round(words / 200)) },
        };
    });
}

const { book, Content, minutes } = Astro.props;

const amazonSearch = `https://www.amazon.sa/s?k=${encodeURIComponent(book.title + " " + book.author)}`;
const goodreadsSearch = `https://www.goodreads.com/search?q=${encodeURIComponent(book.title + " " + book.author)}`;
const quotesUrl = book.quotesSlug ? `https://elhellal.com/quotes/book/${encodeURIComponent(book.quotesSlug)}/` : null;
---

<Layout
    pageTitle={`ملخص كتاب ${book.title} - ${book.author} | الهلال`}
    pageDescription={book.summary.slice(0, 155)}
    canonicalUrl={`https://books.elhellal.com/${book.slug}/`}
    ogImage={book.cover}
>
    <main class="page">
        <nav class="breadcrumb" aria-label="مسار التنقل">
            <a href="/">ملخصات كتب</a>
            <span aria-hidden="true">›</span>
            <span>{book.title}</span>
        </nav>

        <article class="book">
            <aside class="cover-col">
                <img src={book.cover} alt={book.title} class="cover" />
                <div class="links">
                    <a href={amazonSearch} target="_blank" rel="nofollow sponsored noopener">اشترِ من أمازون</a>
                    <a href={goodreadsSearch} target="_blank" rel="nofollow noopener">صفحة Goodreads</a>
                    {quotesUrl && <a href={quotesUrl}>اقتباسات من الكتاب</a>}
                </div>
            </aside>

            <div class="content-col">
                <p class="genre">{book.genre}{book.year ? ` · ${book.year}` : ""}</p>
                <h1>{book.title}</h1>
                <p class="author">بقلم {book.author}</p>
                {book.award && <p class="award">🏆 {book.award}</p>}

                {Content ? (
                    <>
                        <p class="lead">{book.summary}</p>
                        <p class="reading-time">وقت القراءة: نحو {minutes.toLocaleString("ar-EG")} دقائق</p>
                        <section class="prose">
                            <Content />
                        </section>
                        <AdUnit slot="8525183818" format="fluid" layout="in-article" />
                    </>
                ) : (
                    <section>
                        <h2>نبذة عن الكتاب</h2>
                        <p>{book.summary}</p>
                    </section>
                )}

                <section>
                    <h2>الأفكار الرئيسية</h2>
                    <ul>
                        {book.keyIdeas.map((idea: string) => <li>{idea}</li>)}
                    </ul>
                </section>

                <section>
                    <h2>لمن هذا الكتاب</h2>
                    <p>{book.whoShouldRead}</p>
                </section>

                <AdUnit slot="2951250905" minHeight={250} />
            </div>
        </article>
    </main>

    <style>
        .page {
            max-width: 1000px;
            margin: 0 auto;
            padding: var(--spacing-07) var(--spacing-09) var(--spacing-10);
        }
        .breadcrumb {
            display: flex;
            gap: 6px;
            font-family: var(--monospace);
            font-size: var(--desktop-caption);
            line-height: var(--lh-desktop-caption);
            color: var(--content-secondary);
            margin-bottom: var(--spacing-06);
        }
        .breadcrumb a {
            color: inherit;
            text-decoration: none;
        }
        .breadcrumb a:hover {
            color: var(--accent);
        }
        .book {
            display: grid;
            grid-template-columns: 220px 1fr;
            gap: var(--spacing-07);
        }
        @media (max-width: 640px) {
            .book { grid-template-columns: 1fr; }
            .page { padding: var(--spacing-06) var(--spacing-05) var(--spacing-09); }
        }
        .cover {
            width: 100%;
            border-radius: 12px;
            display: block;
            background-color: #111111;
            box-shadow:
                0px 0px 0px 0.5px rgba(255, 255, 255, 0.08),
                0px 4px 16px rgba(0, 0, 0, 0.4);
        }
        .links {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-02);
            margin-top: var(--spacing-05);
        }
        .links a {
            text-align: center;
            padding: var(--spacing-02) var(--spacing-05);
            border: 0.5px solid var(--border-muted);
            background-color: var(--background);
            text-decoration: none;
            color: var(--content-secondary);
            font-size: var(--desktop-body-sm);
            line-height: var(--lh-desktop-body-sm);
            transition: transform 0.2s ease, color 0.15s ease;
        }
        .links a:hover {
            color: var(--accent);
        }
        .links a:active {
            transform: scale(0.97);
        }
        .genre {
            margin: 0 0 var(--spacing-02);
            font-family: var(--monospace);
            font-size: var(--desktop-caption);
            color: var(--accent);
        }
        h1 {
            margin: 0 0 var(--spacing-01);
            font-size: clamp(1.5rem, 3vw, 2.25rem);
            color: var(--content-primary);
        }
        .author {
            margin: 0 0 var(--spacing-02);
            color: var(--content-secondary);
        }
        .award {
            display: inline-block;
            font-family: var(--monospace);
            font-size: 11px;
            line-height: 1.5;
            margin: 0 0 var(--spacing-04);
            padding: 2px 8px;
            border-radius: 4px;
            background: rgba(255, 80, 0, 0.2);
            color: #ff7a40;
            border: 0.5px solid rgba(255, 80, 0, 0.3);
        }
        section {
            margin-top: var(--spacing-06);
        }
        section h2 {
            font-size: 1.1rem;
            margin: 0 0 var(--spacing-02);
            padding-bottom: var(--spacing-02);
            border-bottom: 0.5px solid var(--border-muted);
            color: var(--content-primary);
        }
        section p, section ul {
            line-height: 1.8;
            margin: 0;
        }
        section ul {
            padding-inline-start: 1.2rem;
        }
        section li {
            margin-bottom: 6px;
        }
        section li::marker {
            color: var(--accent);
        }
        .lead {
            margin: var(--spacing-05) 0 var(--spacing-02);
            font-size: 1.15rem;
            line-height: 1.9;
            color: var(--content-secondary);
        }
        .reading-time {
            margin: 0;
            font-family: var(--monospace);
            font-size: var(--desktop-caption);
            color: var(--content-secondary-alt);
        }
        .prose :global(h2) {
            margin: var(--spacing-07) 0 var(--spacing-03);
            font-size: 1.35rem;
        }
        .prose :global(p) {
            margin: 0 0 var(--spacing-04);
            font-size: 1.05rem;
            line-height: 2;
        }
        .prose :global(blockquote) {
            margin: var(--spacing-05) 0;
            padding: 0 var(--spacing-04);
            border-inline-start: 2px solid var(--accent);
            color: var(--content-secondary);
        }
        .prose :global(a) {
            color: var(--accent);
        }
    </style>
</Layout>
