---
import Layout from "../layouts/Layout.astro";
import books from "../data/books.json";
import AdUnit from "../components/AdUnit.astro";

const PAGE_SIZE = 20;
const sorted = [...books].sort((a, b) => a.title.localeCompare(b.title, "ar"));
const fmt = (n: number) => n.toLocaleString("ar-EG");

// A book can sit in several topics: "سيرة ذاتية / أدب رحلات" is both.
// "رواية تاريخية" and "رواية ديستوبية" collapse into "رواية".
const topicsOf = (genre: string) => [
    ...new Set(genre.split(/\s*\/\s*/).map((g) => (g.startsWith("رواية") ? "رواية" : g))),
];
const topicCounts = new Map<string, number>();
for (const b of sorted) for (const t of topicsOf(b.genre)) topicCounts.set(t, (topicCounts.get(t) ?? 0) + 1);
const topics = [...topicCounts].sort((a, b) => a[0].localeCompare(b[0], "ar"));
---

<Layout
    pageTitle="ملخصات كتب عربية | الهلال"
    pageDescription="ملخصات موجزة لأهم الروايات والكتب العربية: الأفكار الرئيسية، لمن هذا الكتاب، واقتباساته الأشهر."
    canonicalUrl="https://books.elhellal.com/"
>
    <main class="page">
        <header class="intro">
            <h1>مكتبة الملخصات</h1>
            <p>الأفكار الرئيسية في أشهر الكتب العربية، تقرؤها في دقائق.</p>
        </header>

        <div class="layout">
            <aside class="topics">
                <details open id="topics">
                    <summary>موضوعات الكتب</summary>
                    <ul role="list">
                        <li>
                            <button class="topic" data-topic="" aria-pressed="true">
                                <span class="name">كل الكتب</span>
                                <span class="pill">{fmt(sorted.length)}</span>
                            </button>
                        </li>
                        {topics.map(([t, n]) => (
                            <li>
                                <button class="topic" data-topic={t} aria-pressed="false">
                                    <span class="name">{t}</span>
                                    <span class="pill">{fmt(n)}</span>
                                </button>
                            </li>
                        ))}
                    </ul>
                </details>
            </aside>

            <section class="results">
                <div class="toolbar">
                    <nav id="pager" class="pager" aria-label="الصفحات"></nav>
                    <p id="status" class="status" aria-live="polite"></p>
                    <label class="search">
                        <span class="visually-hidden">ابحث عن كتاب أو مؤلف</span>
                        <input id="q" type="search" placeholder="ابحث عن كتاب أو مؤلف…" autocomplete="off" />
                    </label>
                </div>

                <ul role="list" class="grid" id="grid">
                    {sorted.map((b) => (
                        <li
                            data-title={b.title}
                            data-author={b.author}
                            data-topics={topicsOf(b.genre).join("|")}
                        >
                            <a href={`/${b.slug}/`} class="book" aria-label={`${b.title} — ${b.author}`}>
                                <img src={b.cover} alt="" loading="lazy" />
                                <span class="overlay">
                                    <span class="overlay-title">{b.title}</span>
                                    <span class="overlay-author">{b.author}</span>
                                    <span class="cta">شاهد التفاصيل</span>
                                </span>
                            </a>
                        </li>
                    ))}
                </ul>

                <p id="empty" class="empty" hidden>لا توجد نتائج مطابقة. جرّب كلمة أخرى أو اختر «كل الكتب».</p>
                <AdUnit slot="2951250905" />
            </section>
        </div>
    </main>

    <script define:vars={{ PAGE_SIZE }}>
        const grid = document.getElementById("grid");
        const items = Array.from(grid.children);
        const q = document.getElementById("q");
        const topicBtns = Array.from(document.querySelectorAll(".topic"));
        const empty = document.getElementById("empty");
        const status = document.getElementById("status");
        const pager = document.getElementById("pager");
        const topicsBox = document.getElementById("topics");
        const nf = new Intl.NumberFormat("ar-EG");
        let topic = "";
        let page = 1;

        if (matchMedia("(max-width: 800px)").matches) topicsBox.open = false;

        // Drop tashkeel/tatweel and unify alef/yaa/taa-marbuta so searches match loosely.
        const norm = (s) =>
            s
                .replace(/[ً-ٟـ]/g, "")
                .replace(/[إأآ]/g, "ا")
                .replace(/ى/g, "ي")
                .replace(/ة/g, "ه")
                .toLowerCase();

        function render() {
            const term = norm(q.value.trim());
            const matches = items.filter((li) => {
                const inTopic = !topic || li.dataset.topics.split("|").includes(topic);
                const inSearch = !term || norm(li.dataset.title + " " + li.dataset.author).includes(term);
                return inTopic && inSearch;
            });
            const pages = Math.max(1, Math.ceil(matches.length / PAGE_SIZE));
            page = Math.min(page, pages);
            const start = (page - 1) * PAGE_SIZE;
            const visible = new Set(matches.slice(start, start + PAGE_SIZE));
            items.forEach((li) => (li.hidden = !visible.has(li)));

            empty.hidden = matches.length > 0;
            status.textContent = matches.length
                ? `عرض من ${nf.format(start + 1)} - ${nf.format(start + visible.size)} من أصل ${nf.format(matches.length)} كتاب`
                : "";

            pager.replaceChildren();
            if (pages > 1) {
                for (let p = 1; p <= pages; p++) {
                    const b = document.createElement("button");
                    b.textContent = nf.format(p);
                    b.setAttribute("aria-label", `صفحة ${nf.format(p)}`);
                    if (p === page) b.setAttribute("aria-current", "page");
                    b.addEventListener("click", () => {
                        page = p;
                        render();
                        grid.scrollIntoView({ behavior: "smooth", block: "start" });
                    });
                    pager.appendChild(b);
                }
            }
        }

        q.addEventListener("input", () => {
            page = 1;
            render();
        });
        topicBtns.forEach((btn) =>
            btn.addEventListener("click", () => {
                topic = btn.dataset.topic;
                page = 1;
                topicBtns.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
                render();
            }),
        );
        render();
    </script>

    <style>
        .page {
            max-width: 1100px;
            margin: 0 auto;
            padding: var(--spacing-08) var(--spacing-09) var(--spacing-10);
        }
        .intro {
            margin-bottom: var(--spacing-07);
        }
        h1 {
            margin: 0 0 var(--spacing-02);
            font-size: clamp(1.75rem, 4vw, 2.5rem);
            color: var(--content-primary);
        }
        .intro p {
            margin: 0;
            font-family: var(--monospace);
            font-size: var(--desktop-caption);
            line-height: var(--lh-desktop-caption);
            color: var(--content-secondary);
        }

        /* Sidebar first in the DOM so RTL puts it on the right. */
        .layout {
            display: grid;
            grid-template-columns: 240px minmax(0, 1fr);
            gap: var(--spacing-06);
            align-items: start;
        }
        .topics {
            position: sticky;
            top: var(--spacing-04);
            border: 0.5px solid var(--border-muted);
            background: var(--background);
            overflow: hidden;
        }
        summary {
            cursor: pointer;
            list-style: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: var(--spacing-04) var(--spacing-05);
            font-family: "ROM-Bold", var(--system-ui);
            color: var(--content-primary);
            background: var(--background-secondary);
            border-bottom: 0.5px solid var(--border-muted);
        }
        details:not([open]) summary {
            border-bottom: 0;
        }
        summary::-webkit-details-marker {
            display: none;
        }
        summary::after {
            content: "";
            width: 0.4rem;
            height: 0.4rem;
            border: solid currentColor;
            border-width: 0 1.5px 1.5px 0;
            transform: rotate(45deg);
            transition: transform 0.15s ease;
        }
        details[open] summary::after {
            transform: rotate(-135deg);
        }
        .topics ul {
            list-style: none;
            margin: 0;
            padding: 0;
            max-height: 70vh;
            overflow-y: auto;
        }
        .topic {
            font: inherit;
            font-size: var(--desktop-body-sm);
            line-height: var(--lh-desktop-body-sm);
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: var(--spacing-03);
            padding: var(--spacing-03) var(--spacing-05);
            color: var(--content-secondary);
            background: transparent;
            border: 0;
            border-bottom: 0.5px solid var(--border-muted);
            cursor: pointer;
            text-align: start;
            transition: background-color 0.15s ease, color 0.15s ease;
        }
        .topics li:last-child .topic {
            border-bottom: 0;
        }
        .topic:hover {
            color: var(--content-primary);
            background: var(--background-secondary);
        }
        .topic[aria-pressed="true"] {
            color: var(--accent);
            font-family: "ROM-Bold", var(--system-ui);
        }
        .pill {
            min-width: var(--spacing-07);
            text-align: center;
            font-family: var(--monospace);
            font-size: var(--desktop-caption);
            color: var(--content-secondary-alt);
        }
        .topic:hover .pill,
        .topic[aria-pressed="true"] .pill {
            color: inherit;
        }

        .toolbar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: var(--spacing-03) var(--spacing-05);
            margin-bottom: var(--spacing-05);
        }
        .status {
            margin: 0;
            font-family: var(--monospace);
            font-size: var(--desktop-caption);
            color: var(--content-secondary);
            margin-inline-end: auto;
        }
        .pager {
            display: flex;
            gap: var(--spacing-02);
            flex-wrap: wrap;
        }
        .pager:empty {
            display: none;
        }
        .pager button {
            font-family: var(--monospace);
            font-size: var(--desktop-caption);
            min-width: var(--spacing-08);
            height: var(--spacing-08);
            cursor: pointer;
            color: var(--content-secondary);
            background: var(--background);
            border: 0.5px solid var(--border-muted);
            transition: transform 0.2s ease, color 0.15s ease;
        }
        .pager button:hover {
            color: var(--accent);
        }
        .pager button:active {
            transform: scale(0.97);
        }
        .pager button[aria-current="page"] {
            background: var(--accent);
            border-color: var(--accent);
            color: #111;
            font-weight: 700;
        }
        .search {
            flex: 0 1 18rem;
        }
        input[type="search"] {
            width: 100%;
            box-sizing: border-box;
            font: inherit;
            font-size: var(--desktop-body-sm);
            line-height: var(--lh-desktop-body-sm);
            padding: var(--spacing-03) var(--spacing-04);
            color: var(--content-primary);
            background: var(--background);
            border: 0.5px solid var(--border-muted);
            border-radius: 0;
            outline: none;
        }
        input[type="search"]::placeholder {
            color: var(--content-placeholder);
        }
        input[type="search"]:focus {
            border-color: var(--border);
        }
        .topic:focus-visible,
        .pager button:focus-visible,
        summary:focus-visible,
        .book:focus-visible {
            outline: 1px solid var(--button-primary);
            outline-offset: 2px;
        }

        .grid {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
            gap: var(--spacing-05);
        }
        .grid li[hidden] {
            display: none;
        }
        /* Same card shell as elhellal's article cards: #111, 12px radius, hairline ring. */
        .book {
            position: relative;
            display: block;
            overflow: hidden;
            border-radius: 12px;
            background-color: #111111;
            box-shadow:
                0px 0px 0px 0.5px rgba(255, 255, 255, 0.08),
                0px 4px 16px rgba(0, 0, 0, 0.4);
            text-decoration: none;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .book:is(:hover, :focus-visible) {
            transform: translateY(-2px);
            box-shadow:
                0px 0px 0px 1px rgba(255, 255, 255, 0.15),
                0px 8px 24px rgba(0, 0, 0, 0.5);
        }
        .book img {
            display: block;
            width: 100%;
            aspect-ratio: 2 / 3;
            object-fit: cover;
            background-color: #1a1a1a;
        }
        .overlay {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.35rem;
            padding: var(--spacing-04);
            text-align: center;
            color: #fff;
            background: rgba(0, 0, 0, 0.82);
            opacity: 0;
            transition: opacity 0.15s ease;
        }
        .book:hover .overlay,
        .book:focus-visible .overlay {
            opacity: 1;
        }
        .overlay-title {
            font-family: "ROM-Bold", var(--system-ui);
            font-size: 1rem;
            line-height: 1.4;
            color: #f0f0f0;
        }
        .overlay-author {
            font-family: var(--monospace);
            font-size: 11px;
            color: rgba(255, 255, 255, 0.5);
        }
        .cta {
            margin-top: var(--spacing-03);
            padding: 2px 8px;
            font-family: var(--monospace);
            font-size: 11px;
            line-height: 1.5;
            border-radius: 4px;
            background: rgba(255, 80, 0, 0.2);
            color: #ff7a40;
            border: 0.5px solid rgba(255, 80, 0, 0.3);
        }
        /* No hover on touch: show the title as a bottom strip instead. */
        @media (hover: none) {
            .overlay {
                inset: auto 0 0 0;
                opacity: 1;
                padding: var(--spacing-03);
                background: linear-gradient(transparent, rgba(0, 0, 0, 0.9));
                justify-content: flex-end;
            }
            .overlay-title {
                font-size: 0.9rem;
            }
            .overlay-author,
            .cta {
                display: none;
            }
        }

        .empty {
            text-align: center;
            font-family: var(--monospace);
            font-size: var(--desktop-caption);
            color: var(--content-secondary);
            padding: var(--spacing-08) 0;
        }
        .visually-hidden {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip: rect(0 0 0 0);
            white-space: nowrap;
        }

        @media (max-width: 800px) {
            .layout {
                grid-template-columns: 1fr;
            }
            .topics {
                position: static;
            }
            .grid {
                grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            }
        }
        @media (max-width: 30rem) {
            .page {
                padding: var(--spacing-06) var(--spacing-05) var(--spacing-09);
            }
        }
    </style>
</Layout>
