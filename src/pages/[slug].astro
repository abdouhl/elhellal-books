---
import Layout from "../layouts/Layout.astro";
import books from "../data/books.json";

export function getStaticPaths() {
    // Long-form summaries live in src/content/summaries/<slug>.md; books without one fall back to the short entry.
    const longForm = import.meta.glob("../content/summaries/*.md", { eager: true }) as Record<string, any>;
    return books.map((b) => {
        const md = longForm[`../content/summaries/${b.slug}.md`];
        const words = md ? md.rawContent().split(/\s+/).filter(Boolean).length : 0;
        return {
            params: { slug: b.slug },
            props: { book: b, Content: md?.Content ?? null, minutes: Math.max(1, Math.round(words / 200)) },
        };
    });
}

const { book, Content, minutes } = Astro.props;

const amazonSearch = `https://www.amazon.sa/s?k=${encodeURIComponent(book.title + " " + book.author)}`;
const goodreadsSearch = `https://www.goodreads.com/search?q=${encodeURIComponent(book.title + " " + book.author)}`;
const quotesUrl = book.quotesSlug ? `https://elhellal.com/quotes/book/${encodeURIComponent(book.quotesSlug)}/` : null;
---

<Layout
    pageTitle={`ملخص كتاب ${book.title} - ${book.author} | الهلال`}
    pageDescription={book.summary.slice(0, 155)}
    canonicalUrl={`https://books.elhellal.com/${book.slug}/`}
    ogImage={book.cover}
>
    <main class="page">
        <nav class="breadcrumb" aria-label="مسار التنقل">
            <a href="/">ملخصات كتب</a>
            <span aria-hidden="true">›</span>
            <span>{book.title}</span>
        </nav>

        <article class="book">
            <aside class="cover-col">
                <img src={book.cover} alt={book.title} class="cover" />
                <div class="links">
                    <a href={amazonSearch} target="_blank" rel="nofollow sponsored noopener">اشترِ من أمازون</a>
                    <a href={goodreadsSearch} target="_blank" rel="nofollow noopener">صفحة Goodreads</a>
                    {quotesUrl && <a href={quotesUrl}>اقتباسات من الكتاب</a>}
                </div>
            </aside>

            <div class="content-col">
                <p class="genre">{book.genre}{book.year ? ` · ${book.year}` : ""}</p>
                <h1>{book.title}</h1>
                <p class="author">بقلم {book.author}</p>
                {book.award && <p class="award">🏆 {book.award}</p>}

                {Content ? (
                    <>
                        <p class="lead">{book.summary}</p>
                        <p class="reading-time">وقت القراءة: نحو {minutes.toLocaleString("ar-EG")} دقائق</p>
                        <section class="prose">
                            <Content />
                        </section>
                    </>
                ) : (
                    <section>
                        <h2>نبذة عن الكتاب</h2>
                        <p>{book.summary}</p>
                    </section>
                )}

                <section>
                    <h2>الأفكار الرئيسية</h2>
                    <ul>
                        {book.keyIdeas.map((idea: string) => <li>{idea}</li>)}
                    </ul>
                </section>

                <section>
                    <h2>لمن هذا الكتاب</h2>
                    <p>{book.whoShouldRead}</p>
                </section>
            </div>
        </article>
    </main>

    <style>
        .page {
            max-width: 1000px;
            margin: 0 auto;
            padding: var(--spacing-06, 1.5rem) var(--spacing-05, 1.25rem) var(--spacing-10, 3rem);
        }
        .breadcrumb {
            display: flex;
            gap: 6px;
            font-size: 0.8rem;
            color: var(--content-secondary, #666);
            margin-bottom: var(--spacing-06, 1.5rem);
        }
        .breadcrumb a {
            color: inherit;
            text-decoration: none;
        }
        .book {
            display: grid;
            grid-template-columns: 220px 1fr;
            gap: var(--spacing-07, 2rem);
        }
        @media (max-width: 640px) {
            .book { grid-template-columns: 1fr; }
        }
        .cover {
            width: 100%;
            border-radius: 8px;
            display: block;
        }
        .links {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: var(--spacing-04, 1rem);
        }
        .links a {
            text-align: center;
            padding: 10px 14px;
            border: 1px solid var(--border, #e5e5e5);
            border-radius: 6px;
            text-decoration: none;
            color: var(--content-primary, #111);
            font-size: 0.85rem;
        }
        .links a:hover {
            border-color: var(--accent, #0a5);
            color: var(--accent, #0a5);
        }
        .genre {
            margin: 0 0 4px;
            font-size: 0.8rem;
            color: var(--accent, #0a5);
        }
        h1 {
            margin: 0 0 4px;
            font-size: clamp(1.5rem, 3vw, 2.25rem);
        }
        .author {
            margin: 0 0 8px;
            color: var(--content-secondary, #666);
        }
        .award {
            font-size: 0.85rem;
            margin: 0 0 var(--spacing-04, 1rem);
        }
        section {
            margin-top: var(--spacing-06, 1.5rem);
        }
        section h2 {
            font-size: 1.1rem;
            margin: 0 0 8px;
        }
        section p, section ul {
            line-height: 1.8;
            margin: 0;
        }
        section ul {
            padding-inline-start: 1.2rem;
        }
        section li {
            margin-bottom: 6px;
        }
        .lead {
            margin: var(--spacing-05, 1.25rem) 0 var(--spacing-02, 0.5rem);
            font-size: 1.15rem;
            line-height: 1.9;
            color: var(--content-secondary, #555);
        }
        .reading-time {
            margin: 0;
            font-size: 0.8rem;
            color: var(--content-secondary, #666);
        }
        .prose :global(h2) {
            margin: var(--spacing-07, 2rem) 0 var(--spacing-03, 0.75rem);
            font-size: 1.35rem;
        }
        .prose :global(p) {
            margin: 0 0 var(--spacing-04, 1rem);
            font-size: 1.05rem;
            line-height: 2;
        }
        .prose :global(blockquote) {
            margin: var(--spacing-05, 1.25rem) 0;
            padding: 0 var(--spacing-04, 1rem);
            border-inline-start: 3px solid var(--link, #0a5);
            color: var(--content-secondary, #555);
        }
    </style>
</Layout>
