---
import Layout from "../layouts/Layout.astro";
import books from "../data/books.json";
import AdUnit from "../components/AdUnit.astro";

export function getStaticPaths() {
    // Long-form summaries live in src/content/summaries/<slug>.md; books without one fall back to the short entry.
    const longForm = import.meta.glob("../content/summaries/*.md", { eager: true }) as Record<string, any>;
    return books.map((b) => {
        const md = longForm[`../content/summaries/${b.slug}.md`];
        const words = md ? md.rawContent().split(/\s+/).filter(Boolean).length : 0;
        return {
            params: { slug: b.slug },
            props: { book: b, Content: md?.Content ?? null, minutes: Math.max(1, Math.round(words / 200)) },
        };
    });
}

const { book, Content, minutes } = Astro.props;

const amazonSearch = `https://www.amazon.sa/s?k=${encodeURIComponent(book.title + " " + book.author)}`;
const goodreadsSearch = `https://www.goodreads.com/search?q=${encodeURIComponent(book.title + " " + book.author)}`;
const topicsOf = (genre: string) => genre.split(/\s*\/\s*/).map((g) => (g.startsWith("رواية") ? "رواية" : g));
const bookTopics = topicsOf(book.genre);
// Same author first, then same exact genre, then any shared topic; index order keeps ties stable.
const related = books
    .filter((b) => b.slug !== book.slug)
    .map((b) => {
        const sameAuthor = b.authorSlug === book.authorSlug;
        const sameGenre = b.genre === book.genre;
        const sharedTopic = topicsOf(b.genre).find((t) => bookTopics.includes(t));
        return {
            b,
            score: (sameAuthor ? 4 : 0) + (sameGenre ? 2 : 0) + (sharedTopic ? 1 : 0),
            reason: sameAuthor ? "من نفس المؤلف" : sameGenre ? b.genre : sharedTopic ?? "قد يعجبك",
            sameAuthor,
        };
    })
    .sort((x, y) => y.score - x.score)
    .slice(0, 4);
const quotesUrl = book.quotesSlug ? `https://elhellal.com/quotes/book/${encodeURIComponent(book.quotesSlug)}/` : null;
---

<Layout
    pageTitle={`ملخص كتاب ${book.title} - ${book.author} | الهلال`}
    pageDescription={book.summary.slice(0, 155)}
    canonicalUrl={`https://books.elhellal.com/${book.slug}/`}
    ogImage={book.cover}
>
    <main class="page">
        <nav class="breadcrumb" aria-label="مسار التنقل">
            <a href="/">ملخصات كتب</a>
            <span aria-hidden="true">›</span>
            <span>{book.title}</span>
        </nav>

        <article class="book">
            <aside class="cover-col">
                <img src={book.cover} alt={book.title} class="cover" />
                <div class="links">
                    <a href={amazonSearch} target="_blank" rel="nofollow sponsored noopener">اشترِ من أمازون</a>
                    <a href={goodreadsSearch} target="_blank" rel="nofollow noopener">صفحة Goodreads</a>
                    {quotesUrl && <a href={quotesUrl}>اقتباسات من الكتاب</a>}
                </div>
                <AdUnit slot="2951250905" minHeight={250} className="side-ad" />
            </aside>

            <div class="content-col">
                <p class="genre">{book.genre}{book.year ? ` · ${book.year}` : ""}</p>
                <h1>{book.title}</h1>
                <p class="author">بقلم {book.author}</p>
                {book.award && <p class="award">🏆 {book.award}</p>}

                {Content ? (
                    <>
                        <p class="lead">{book.summary}</p>
                        <p class="reading-time">وقت القراءة: نحو {minutes.toLocaleString("ar-EG")} دقائق</p>
                        <section class="prose">
                            <Content />
                        </section>
                        <AdUnit slot="8525183818" format="fluid" layout="in-article" />
                    </>
                ) : (
                    <section>
                        <h2>نبذة عن الكتاب</h2>
                        <p>{book.summary}</p>
                    </section>
                )}

                <section>
                    <h2>الأفكار الرئيسية</h2>
                    <ul>
                        {book.keyIdeas.map((idea: string) => <li>{idea}</li>)}
                    </ul>
                </section>

                <section>
                    <h2>لمن هذا الكتاب</h2>
                    <p>{book.whoShouldRead}</p>
                </section>
            </div>
        </article>

        {related.length > 0 && (
            <section class="related" aria-labelledby="related-title">
                <header class="related-head">
                    <h2 id="related-title">كتب ذات صلة</h2>
                    <a href="/" class="related-all">كل الكتب ←</a>
                </header>
                <ul role="list" class="related-grid">
                    {related.map(({ b, reason, sameAuthor }) => (
                        <li>
                            <a href={`/${b.slug}/`} class="related-card">
                                <img src={b.cover} alt={b.title} loading="lazy" />
                                <span class="related-body">
                                    <span class:list={["related-tag", { "is-author": sameAuthor }]}>{reason}</span>
                                    <span class="related-title">{b.title}</span>
                                    <span class="related-author">{b.author}{b.year ? ` · ${b.year}` : ""}</span>
                                    <span class="related-cta">اقرأ الملخص ←</span>
                                </span>
                            </a>
                        </li>
                    ))}
                </ul>
            </section>
        )}
    </main>

    <style>
        .page {
            max-width: 1000px;
            margin: 0 auto;
            padding: var(--spacing-07) var(--spacing-09) var(--spacing-10);
        }
        .breadcrumb {
            display: flex;
            gap: 6px;
            font-family: var(--monospace);
            font-size: var(--desktop-caption);
            line-height: var(--lh-desktop-caption);
            color: var(--content-secondary);
            margin-bottom: var(--spacing-06);
        }
        .breadcrumb a {
            color: inherit;
            text-decoration: none;
        }
        .breadcrumb a:hover {
            color: var(--accent);
        }
        .book {
            display: grid;
            grid-template-columns: 220px 1fr;
            gap: var(--spacing-07);
        }
        @media (max-width: 640px) {
            .book { grid-template-columns: 1fr; }
            .page { padding: var(--spacing-06) var(--spacing-05) var(--spacing-09); }
        }
        .cover-col {
            align-self: start;
            position: sticky;
            top: var(--spacing-09);
        }
        @media (max-width: 640px) {
            .cover-col { position: static; }
        }
        .cover-col :global(.side-ad) {
            margin-top: var(--spacing-05);
        }
        .cover {
            width: 100%;
            border-radius: 12px;
            display: block;
            background-color: #111111;
            box-shadow:
                0px 0px 0px 0.5px rgba(255, 255, 255, 0.08),
                0px 4px 16px rgba(0, 0, 0, 0.4);
        }
        .links {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-02);
            margin-top: var(--spacing-05);
        }
        .links a {
            text-align: center;
            padding: var(--spacing-02) var(--spacing-05);
            border: 0.5px solid var(--border-muted);
            background-color: var(--background);
            text-decoration: none;
            color: var(--content-secondary);
            font-size: var(--desktop-body-sm);
            line-height: var(--lh-desktop-body-sm);
            transition: transform 0.2s ease, color 0.15s ease;
        }
        .links a:hover {
            color: var(--accent);
        }
        .links a:active {
            transform: scale(0.97);
        }
        .genre {
            margin: 0 0 var(--spacing-02);
            font-family: var(--monospace);
            font-size: var(--desktop-caption);
            color: var(--accent);
        }
        h1 {
            margin: 0 0 var(--spacing-01);
            font-size: clamp(1.5rem, 3vw, 2.25rem);
            color: var(--content-primary);
        }
        .author {
            margin: 0 0 var(--spacing-02);
            color: var(--content-secondary);
        }
        .award {
            display: inline-block;
            font-family: var(--monospace);
            font-size: 11px;
            line-height: 1.5;
            margin: 0 0 var(--spacing-04);
            padding: 2px 8px;
            border-radius: 4px;
            background: rgba(255, 80, 0, 0.2);
            color: #ff7a40;
            border: 0.5px solid rgba(255, 80, 0, 0.3);
        }
        section {
            margin-top: var(--spacing-06);
        }
        section h2 {
            font-size: 1.1rem;
            margin: 0 0 var(--spacing-02);
            padding-bottom: var(--spacing-02);
            border-bottom: 0.5px solid var(--border-muted);
            color: var(--content-primary);
        }
        section p, section ul {
            line-height: 1.8;
            margin: 0;
        }
        section ul {
            padding-inline-start: 1.2rem;
        }
        section li {
            margin-bottom: 6px;
        }
        section li::marker {
            color: var(--accent);
        }
        .lead {
            margin: var(--spacing-05) 0 var(--spacing-02);
            font-size: 1.15rem;
            line-height: 1.9;
            color: var(--content-secondary);
        }
        .reading-time {
            margin: 0;
            font-family: var(--monospace);
            font-size: var(--desktop-caption);
            color: var(--content-secondary-alt);
        }
        .prose :global(h2) {
            margin: var(--spacing-07) 0 var(--spacing-03);
            font-size: 1.35rem;
        }
        .prose :global(p) {
            margin: 0 0 var(--spacing-04);
            font-size: 1.05rem;
            line-height: 2;
        }
        .prose :global(blockquote) {
            margin: var(--spacing-05) 0;
            padding: 0 var(--spacing-04);
            border-inline-start: 2px solid var(--accent);
            color: var(--content-secondary);
        }
        .prose :global(a) {
            color: var(--accent);
        }
        .related {
            margin-top: var(--spacing-09);
            padding-top: var(--spacing-07);
            border-top: 0.5px solid var(--border-muted);
        }
        .related-head {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            margin-bottom: var(--spacing-05);
        }
        .related-head h2 {
            margin: 0;
            font-size: 1.35rem;
            color: var(--content-primary);
        }
        .related-all {
            font-family: var(--monospace);
            font-size: var(--desktop-caption);
            color: var(--content-secondary);
            text-decoration: none;
        }
        .related-all:hover {
            color: var(--accent);
        }
        .related-grid {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: var(--spacing-05);
        }
        @media (max-width: 800px) {
            .related-grid { grid-template-columns: 1fr; }
        }
        /* Same card shell as the homepage: #111, 12px radius, hairline ring. */
        .related-card {
            display: flex;
            gap: var(--spacing-04);
            height: 100%;
            padding: var(--spacing-04);
            border-radius: 12px;
            background-color: #111111;
            text-decoration: none;
            box-shadow:
                0px 0px 0px 0.5px rgba(255, 255, 255, 0.08),
                0px 4px 16px rgba(0, 0, 0, 0.4);
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .related-card:is(:hover, :focus-visible) {
            transform: translateY(-2px);
            box-shadow:
                0px 0px 0px 1px rgba(255, 255, 255, 0.15),
                0px 8px 24px rgba(0, 0, 0, 0.5);
        }
        .related-card:focus-visible {
            outline: 1px solid var(--button-primary);
            outline-offset: 2px;
        }
        .related-card img {
            flex: none;
            width: 88px;
            aspect-ratio: 2 / 3;
            object-fit: cover;
            align-self: flex-start;
            border-radius: 6px;
            background-color: #1a1a1a;
            box-shadow: 0px 0px 0px 0.5px rgba(255, 255, 255, 0.1);
        }
        .related-body {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
            min-width: 0;
        }
        .related-tag {
            padding: 1px 8px;
            font-family: var(--monospace);
            font-size: 11px;
            line-height: 1.6;
            border-radius: 4px;
            color: var(--content-secondary);
            border: 0.5px solid var(--border-muted);
        }
        .related-tag.is-author {
            background: rgba(255, 80, 0, 0.2);
            color: #ff7a40;
            border-color: rgba(255, 80, 0, 0.3);
        }
        .related-title {
            font-family: "ROM-Bold", var(--system-ui);
            font-size: 1.05rem;
            line-height: 1.5;
            color: var(--content-primary);
        }
        .related-card:hover .related-title {
            color: var(--accent);
        }
        .related-author {
            font-family: var(--monospace);
            font-size: 11px;
            color: var(--content-secondary);
        }
        .related-cta {
            margin-top: auto;
            padding-top: var(--spacing-02);
            font-family: var(--monospace);
            font-size: 11px;
            color: var(--accent);
        }
    </style>
</Layout>
